      },
      {
        "command": "strata-code.new.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Strata Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "strata-code.new.explainCode",
        "title": "Explain Code",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.fixCode",
        "title": "Fix Code",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.improveCode",
        "title": "Improve Code",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.addToContext",
        "title": "Add to Context",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
