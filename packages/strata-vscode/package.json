      },
      {
        "command": "strata-code.new.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.focusChatInput",
        "title": "Focus Chat Input",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.toggleAutoApprove",
        "title": "Toggle Auto-Approve",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.openDiffViewer",
        "title": "Open Strata Diff Viewer",
        "category": "Strata Code",
        "icon": "$(diff)"
      },
      {
        "command": "strata-code.new.replyComment",
        "title": "Reply to Strata AI",
        "category": "Strata Code",
        "icon": "$(reply)"
      },
      {
        "command": "strata-code.new.openSettings",
        "title": "Open Settings",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.appearance",
        "title": "Settings: Appearance",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.diffViewer",
        "title": "Settings: Diff Viewer",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.notifications",
        "title": "Settings: Notifications",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.browser",
        "title": "Settings: Browser Automation",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.providers",
        "title": "Settings: Providers",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.agentBehaviour",
        "title": "Settings: Agent Behaviour",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.toggleSelectionTip",
        "title": "Toggle Selection Tip",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.toggleGateway",
        "title": "Toggle Strata Gateway",
        "category": "Strata Code"
      }
    ],
    "submenus": [
      {
        "id": "strata-code.new.editorContextMenu",
        "label": "Strata Code"
      },
      {
        "id": "strata-code.new.terminalContextMenu",
        "label": "Strata Code"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "strata-code.new.replyComment",
          "group": "navigation",
          "when": "commentController == strata-explain"
        }
      ],
      "view/title": [
        {
          "command": "strata-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.kanbanButtonClicked",
          "group": "navigation@3",
          "when": "view == strata-code.SidebarProvider"
        }
      ],
      "scm/title": [
        {
          "command": "strata-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "strata-code.new.explainChanges",
          "group": "1_strata@1",
          "when": "scmProvider == git"
        },
        {
          "command": "strata-code.new.explainBranch",
          "group": "1_strata@2",
          "when": "scmProvider == git"
        },
        {
          "command": "strata-code.new.openDiffViewer",
          "group": "navigation@10",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "strata-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == strata-code.new.TabPanel"
        },
        {
          "command": "strata-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == strata-code.new.TabPanel"
        },
        {
          "command": "strata-code.new.settingsButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == strata-code.new.TabPanel"
        }
      ],
      "editor/context": [
        {
          "submenu": "strata-code.new.editorContextMenu",
          "group": "1_stratacode"
        }
      ],
      "strata-code.new.editorContextMenu": [
        {
          "command": "strata-code.new.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "strata-code.new.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "strata-code.new.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "strata-code.new.addToContext",
          "group": "1_actions@4"
        },
        {
          "command": "strata-code.new.explainFile",
          "group": "2_explain@1"
        }
      ],
      "terminal/context": [
        {
          "submenu": "strata-code.new.terminalContextMenu",
          "group": "2_stratacode"
        }
      ],
      "strata-code.new.terminalContextMenu": [
        {
          "command": "strata-code.new.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "strata-code.new.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "strata-code.new.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "strata-code.new.explainChanges",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "strata-code.new.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "strata-code.new.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "strata-code.new.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "strata-code.new.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "strata-code.new.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "strata-code.new.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "strata-code.new.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.newTerminal",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.advancedWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "sideBarFocus && strata-code.new.sidebarVisible || activeWebviewPanelId == 'strata-code.new.AgentManagerPanel' || activeWebviewPanelId == 'strata-code.new.TabPanel'"
      },
      {
        "command": "strata-code.new.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "sideBarFocus && strata-code.new.sidebarVisible || activeWebviewPanelId == 'strata-code.new.AgentManagerPanel' || activeWebviewPanelId == 'strata-code.new.TabPanel'"
      },
      {
        "command": "strata-code.new.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && strata-code.new.autocomplete.hasSuggestions"
      },
      {
        "command": "strata-code.new.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && stratacode.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "strata-code.new.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && stratacode.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "strata-code.new.addToContext",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": [
      {
        "title": "Strata Code: General",
        "order": 1,
        "properties": {
          "strata-code.new.language": {
            "type": "string",
            "default": "",
            "order": 1,
            "description": "Override the UI language for Strata Code (e.g. en, de, ja). Empty means use VS Code's display language.",
            "enum": [
              "",
              "en",
              "zh",
              "zht",
              "ko",
              "de",
              "es",
              "fr",
              "da",
              "ja",
              "pl",
              "ru",
              "ar",
              "no",
              "br",
              "th",
              "bs",
              "tr",
              "nl",
              "uk"
            ],
            "enumDescriptions": [
              "Auto (VS Code language)",
              "English",
              "简体中文",
              "繁體中文",
              "한국어",
              "Deutsch",
              "Español",
              "Français",
              "Dansk",
              "日本語",
              "Polski",
              "Русский",
              "العربية",
              "Norsk",
              "Português (Brasil)",
              "ภาษาไทย",
              "Bosanski",
              "Türkçe",
              "Nederlands",
              "Українська"
            ]
          },
          "strata-code.new.showSelectionTip": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Show an inline hint when selecting code, reminding you of the shortcut to add the selection to Strata chat."
          },
          "strata-code.new.showTaskTimeline": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "Show the task timeline graph in the chat header."
          },
          "strata-code.new.enableGateway": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "description": "Enable Strata Gateway provider. When disabled, the Strata Gateway and its models are hidden from the UI."
          },
          "strata-code.new.claudeCodeCompat": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Load `CLAUDE.md` instructions and skills from your Claude Code configuration directory into Strata sessions. Enable this if you want Strata to use your Claude Code instructions and skills."
          },
          "strata-code.new.logLevel": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error",
              "off"
            ],
            "default": "info",
            "order": 6,
            "description": "Log level for the Strata Code extension (defaults to debug in development)."
          },
          "strata-code.new.logRetentionDays": {
            "type": "number",
            "default": 7,
            "order": 7,
            "description": "Number of days to keep rotated log files."
          }
        }
      },
      {
        "title": "Strata Code: Autocomplete",
        "order": 2,
        "properties": {
          "strata-code.new.autocomplete.enableAutoTrigger": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Enable automatic inline completion suggestions."
          },
          "strata-code.new.autocomplete.model": {
            "type": "string",
            "order": 2,
            "enum": [
              "mistralai/codestral-2508",
              "inception/mercury-edit"
            ],
            "enumDescriptions": [
              "Codestral by Mistral AI (default)",
              "Mercury Edit by Inception"
            ],
            "description": "Model to use for inline autocomplete suggestions."
          },
          "strata-code.new.autocomplete.enableChatAutocomplete": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "description": "Enable chat textarea autocomplete."
          },
          "strata-code.new.autocomplete.enableSmartInlineTaskKeybinding": {
            "type": "boolean",
            "default": false,
            "order": 4,
            "description": "Enable smart inline task keybinding."
          }
        }
      },
      {
        "title": "Strata Code: Diff Viewer",
        "order": 3,
        "properties": {
          "strata-code.new.explainer.mode": {
            "type": "string",
            "enum": [
              "strata",
              "native"
            ],
            "enumDescriptions": [
              "Strata Diff Viewer",
              "Native VS Code Comments"
            ],
            "default": "strata",
            "order": 1,
            "description": "Choose whether to show AI change explanations in the Strata Diff Viewer or as native VS Code comments."
          },
          "strata-code.new.explainer.effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "enumDescriptions": [
              "Low (Only complex changes)",
              "Medium (Standard)",
              "High (All except very simple changes)"
            ],
            "default": "medium",
            "order": 2,
            "description": "Control which changes the AI comments on. Low skips most things; High comments on almost everything."
          },
          "strata-code.new.diffViewer.instantComments": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "When enabled, adding a comment in the diff viewer instantly asks the AI to answer it in a thread. When disabled, comments are saved as drafts and must be sent to chat manually."
          },
          "strata-code.new.diff.eagerLoad": {
            "type": "boolean",
            "default": false,
            "order": 4,
            "description": "When enabled, the diff viewer loads full file content for all changed files immediately on open instead of waiting until each file accordion is expanded."
          }
        }
      },
      {
        "title": "Strata Code: Background Workers",
        "order": 4,
        "properties": {
          "strata-code.new.workers.enabled": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "markdownDescription": "Enable background context workers. Configure in your project's `strata.jsonc` file under the `workers` key."
          },
          "strata-code.new.workers.autoExplain": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "markdownDescription": "Automatically run the explainer in the background to pre-populate the Changes tab with AI explanations."
          }
        }
      },
      {
        "title": "Strata Code: Browser Automation",
        "order": 5,
        "properties": {
          "strata-code.new.browserAutomation.enabled": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "description": "Enable browser automation powered by Playwright. When enabled, the AI agent can interact with web pages in a visible Chrome window."
          },
          "strata-code.new.browserAutomation.useSystemChrome": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Use your system's installed Chrome browser instead of downloading a separate Chromium instance."
          },
          "strata-code.new.browserAutomation.headless": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "description": "Run browser automation in headless mode (no visible window). When disabled, you can watch the agent interact with the browser."
          }
        }
      },
      {
        "title": "Strata Code: Planning",
        "order": 5,
        "properties": {
          "strata-code.new.planning.taskView": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Show the planning task view (Kanban board) in the sidebar."
          },
          "strata-code.new.planning.documentDrivenTasks": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Enable document-driven tasks. Automatically syncs tasks with markdown plan files."
          }
        }
      },
      {
        "title": "Strata Code: Notifications",
        "order": 6,
        "properties": {
          "strata-code.new.notifications.agent": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Show notification when agent completes a task."
          },
          "strata-code.new.notifications.permissions": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Show notification on permission requests."
          },
          "strata-code.new.notifications.errors": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "Show notification on errors."
          }
        }
      },
      {
        "title": "Strata Code: Sounds",
        "order": 7,
        "properties": {
          "strata-code.new.sounds.agent": {
            "type": "string",
            "default": "default",
            "enum": [
              "default",
              "none"
            ],
            "order": 1,
            "description": "Sound to play when agent completes."
          },
          "strata-code.new.sounds.permissions": {
            "type": "string",
            "default": "default",
            "enum": [
              "default",
              "none"
            ],
            "order": 2,
            "description": "Sound to play on permission requests."
          },
          "strata-code.new.sounds.errors": {
            "type": "string",
            "default": "default",
            "enum": [
              "default",
              "none"
            ],
            "order": 3,
            "description": "Sound to play on errors."
          }
        }
      }
    ]
  },
  "scripts": {
    "prepare:cli-binary": "bun script/local-bin.ts",
    "compile": "bun run prepare:cli-binary -- --force && bun run rebuild-sdk && bun run typecheck && bun run lint && node esbuild.js",
    "watch": "bun run rebuild-sdk && bun run --parallel watch:esbuild watch:tsc",
    "watch:esbuild": "bun run prepare:cli-binary && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:cli": "bun script/watch-cli.ts",
    "package": "bun run prepare:cli-binary && bun run rebuild-sdk && bun run typecheck && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "check-types:webview": "bun script/typecheck.ts --project webview-ui/tsconfig.json",
    "typecheck": "bun run check-types:extension && bun run check-types:webview",
    "check-types:extension": "bun script/typecheck.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check-stratacode-change": "! grep -rn 'stratacode_change' . ../strata-ui/ --exclude='package.json' --exclude='*.md' --exclude-dir='node_modules' --exclude-dir='dist' | grep -v '`stratacode_change`'",
    "lint": "eslint src webview-ui",
    "test": "vscode-test",
    "test:unit": "bun test tests/unit/",
    "rebuild-sdk": "bun run --cwd ../sdk/js build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "snapshot:build": "bun script/dev-snapshot.ts build",
    "snapshot:install": "bun script/dev-snapshot.ts install",
    "extension": "bun script/launch.ts"
  },
