{
  "name": "strata-code",
  "displayName": "Strata Code: AI Coding Agent, Copilot, and Autocomplete",
  "description": "Open Source AI coding agent that generates code from natural language, automates tasks, and runs terminal commands. Features inline autocomplete, browser automation, automated refactoring, and custom modes for planning, coding, and debugging. Supports 500+ AI models including Claude (Anthropic), Gemini, Grok, GPT, Codex and GLM.",
  "version": "7.2.26",
  "icon": "assets/icons/logo-outline-black.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "stratacode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Strata-Org/stratacode.git",
    "directory": "packages/strata-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Strata Code"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "strata",
    "claude",
    "dev",
    "mcp",
    "openrouter",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "sonnet",
    "ai",
    "llama",
    "Strata Code",
    "stratacode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "strata-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          }
        }
      }
    ],
    "icons": {
      "strata-logo": {
        "description": "Strata Code logo",
        "default": {
          "fontPath": "assets/icons/strata-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strata-code-ActivityBar",
          "title": "Strata Code",
          "icon": "assets/icons/strata-comet-v2.svg",
          "darkIcon": "assets/icons/strata-comet-v2.svg"
        }
      ]
    },
    "views": {
      "strata-code-ActivityBar": [
        {
          "type": "webview",
          "id": "strata-code.SidebarProvider",
          "name": "Strata Code"
        }
      ]
    },
    "commands": [
      {
        "command": "strata-code.new.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "strata-code.new.agentManager.showView",
        "title": "Strata: Show Agent Manager"
      },
      {
        "command": "strata-code.new.workers.showStatus",
        "title": "Strata: Show Background Worker Status"
      },
      {
        "command": "strata-code.new.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(layout-panel)"
      },
      {
        "command": "strata-code.new.strataClawOpen",
        "title": "StrataClaw",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "strata-code.new.profileButtonClicked",
        "title": "Profile",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.kanbanButtonClicked",
        "title": "Task Board",
        "icon": "$(checklist)"
      },
      {
        "command": "strata-code.new.openInTab",
        "title": "Strata Code",
        "icon": "$(link-external)"
      },
      {
        "command": "strata-code.new.showChanges",
        "title": "Show Changes",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.applyPendingTasks",
        "title": "Apply Pending Tasks from Plan Files",
        "category": "Strata Code",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "strata-code.new.openPlanFile",
        "title": "Open Plan File",
        "category": "Strata Code",
        "icon": "$(file-text)"
      },
      {
        "command": "strata-code.new.explainChanges",
        "title": "Explain Changes",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.explainBranch",
        "title": "Explain Branch Changes",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.explainMerge",
