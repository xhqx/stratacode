{
  "name": "strata-code",
  "displayName": "Strata Code: AI Coding Agent, Copilot, and Autocomplete",
  "description": "Open Source AI coding agent that generates code from natural language, automates tasks, and runs terminal commands. Features inline autocomplete, browser automation, automated refactoring, and custom modes for planning, coding, and debugging. Supports 500+ AI models including Claude (Anthropic), Gemini, Grok, GPT, Codex and GLM.",
  "version": "7.2.26",
  "icon": "assets/icons/logo-outline-black.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "stratacode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Strata-Org/stratacode.git",
    "directory": "packages/strata-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Strata Code"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "strata",
    "claude",
    "dev",
    "mcp",
    "openrouter",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "sonnet",
    "ai",
    "llama",
    "Strata Code",
    "stratacode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "strata-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          }
        }
      }
    ],
    "icons": {
      "strata-logo": {
        "description": "Strata Code logo",
        "default": {
          "fontPath": "assets/icons/strata-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strata-code-ActivityBar",
          "title": "Strata Code",
          "icon": "assets/icons/strata-comet-v2.svg",
          "darkIcon": "assets/icons/strata-comet-v2.svg"
        }
      ]
    },
    "views": {
      "strata-code-ActivityBar": [
        {
          "type": "webview",
          "id": "strata-code.SidebarProvider",
          "name": "Strata Code"
        }
      ]
    },
    "commands": [
      {
        "command": "strata-code.new.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "strata-code.new.agentManager.showView",
        "title": "Strata: Show Agent Manager"
      },
      {
        "command": "strata-code.new.workers.showStatus",
        "title": "Strata: Show Background Worker Status"
      },
      {
        "command": "strata-code.new.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(layout-panel)"
      },

      {
        "command": "strata-code.new.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "strata-code.new.profileButtonClicked",
        "title": "Profile",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.kanbanButtonClicked",
        "title": "Task Board",
        "icon": "$(checklist)"
      },
      {
        "command": "strata-code.new.openInTab",
        "title": "Strata Code",
        "icon": "$(link-external)"
      },
      {
        "command": "strata-code.new.showChanges",
        "title": "Show Changes",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.applyPendingTasks",
        "title": "Apply Pending Tasks from Plan Files",
        "category": "Strata Code",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "strata-code.new.openPlanFile",
        "title": "Open Plan File",
        "category": "Strata Code",
        "icon": "$(file-text)"
      },
      {
        "command": "strata-code.new.explainChanges",
        "title": "Explain Changes",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.explainBranch",
        "title": "Explain Branch Changes",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.explainMerge",
        "title": "Explain Merge Changes…",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.explainFile",
        "title": "Explain This File's Changes",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.explainHunk",
        "title": "Explain This Change",
        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.openMigrationWizard",
        "title": "Migrate Settings from Legacy Version",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.autocomplete.cancelSuggestions",
        "title": "Cancel Suggested Edits",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.api.sendMessage",
        "title": "Send Message to Chat",
        "category": "Strata Code API"
      },
      {
        "command": "strata-code.new.api.getActiveSession",
        "title": "Get Active Session",
        "category": "Strata Code API"
      },
      {
        "command": "strata-code.new.api.focus",
        "title": "Focus Strata Code",
        "category": "Strata Code API"
      },
      {
        "command": "strata-code.new.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Strata Code",
        "icon": "$(terminal)"
      },
      {
        "command": "strata-code.new.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "Strata Code",
        "icon": "$(play)"
      },
      {
        "command": "strata-code.new.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "Strata Code",
        "icon": "$(diff)"
      },
      {
        "command": "strata-code.new.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "Strata Code",
        "icon": "$(keyboard)"
      },
      {
        "command": "strata-code.new.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.newTerminal",
        "title": "Agent Manager: New Terminal Tab (Experimental)",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.newWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.advancedWorktree",
        "title": "Agent Manager: Advanced New Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo7",
        "title": "Agent Manager: Jump to Item 7",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo8",
        "title": "Agent Manager: Jump to Item 8",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Strata Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "strata-code.new.explainCode",
        "title": "Explain Code",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.fixCode",
        "title": "Fix Code",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.improveCode",
        "title": "Improve Code",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.addToContext",
        "title": "Add to Context",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.terminalFixCommand",
        "title": "Fix This Command",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.focusChatInput",
        "title": "Focus Chat Input",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.toggleAutoApprove",
        "title": "Toggle Auto-Approve",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
        }
      },
      {
        "command": "strata-code.new.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.openDiffViewer",
        "title": "Open Strata Diff Viewer",
        "category": "Strata Code",
        "icon": "$(diff)"
      },
      {
        "command": "strata-code.new.replyComment",
        "title": "Reply to Strata AI",
        "category": "Strata Code",
        "icon": "$(reply)"
      },
      {
        "command": "strata-code.new.openSettings",
        "title": "Open Settings",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.appearance",
        "title": "Settings: Appearance",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.diffViewer",
        "title": "Settings: Diff Viewer",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.notifications",
        "title": "Settings: Notifications",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.browser",
        "title": "Settings: Browser Automation",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.providers",
        "title": "Settings: Providers",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.settings.agentBehaviour",
        "title": "Settings: Agent Behaviour",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.toggleSelectionTip",
        "title": "Toggle Selection Tip",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.toggleGateway",
        "title": "Toggle Strata Gateway",
        "category": "Strata Code"
      }
    ],
    "submenus": [
      {
        "id": "strata-code.new.editorContextMenu",
        "label": "Strata Code"
      },
      {
        "id": "strata-code.new.terminalContextMenu",
        "label": "Strata Code"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "strata-code.new.replyComment",
          "group": "navigation",
          "when": "commentController == strata-explain"
        }
      ],
      "view/title": [
        {
          "command": "strata-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == strata-code.SidebarProvider"
        },
        {
          "command": "strata-code.new.kanbanButtonClicked",
          "group": "navigation@3",
          "when": "view == strata-code.SidebarProvider"
        }
      ],
      "scm/title": [
        {
          "command": "strata-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git && stratacode.commitMessage.enabled"
        },
        {
          "command": "strata-code.new.explainChanges",
          "group": "1_strata@1",
          "when": "scmProvider == git && stratacode.diffViewer.enabled"
        },
        {
          "command": "strata-code.new.explainBranch",
          "group": "1_strata@2",
          "when": "scmProvider == git && stratacode.diffViewer.enabled"
        },
        {
          "command": "strata-code.new.openDiffViewer",
          "group": "navigation@10",
          "when": "scmProvider == git && stratacode.diffViewer.enabled"
        }
      ],
      "editor/title": [
        {
          "command": "strata-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == strata-code.new.TabPanel"
        },
        {
          "command": "strata-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == strata-code.new.TabPanel"
        },
        {
          "command": "strata-code.new.settingsButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == strata-code.new.TabPanel"
        }
      ],
      "editor/context": [
        {
          "submenu": "strata-code.new.editorContextMenu",
          "group": "1_stratacode",
          "when": "stratacode.codeActions.enabled"
        }
      ],
      "strata-code.new.editorContextMenu": [
        {
          "command": "strata-code.new.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "strata-code.new.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "strata-code.new.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "strata-code.new.addToContext",
          "group": "1_actions@4"
        },
        {
          "command": "strata-code.new.explainFile",
          "group": "2_explain@1",
          "when": "stratacode.diffViewer.enabled"
        }
      ],
      "terminal/context": [
        {
          "submenu": "strata-code.new.terminalContextMenu",
          "group": "2_stratacode",
          "when": "stratacode.codeActions.enabled"
        }
      ],
      "strata-code.new.terminalContextMenu": [
        {
          "command": "strata-code.new.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "strata-code.new.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "strata-code.new.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "strata-code.new.explainChanges",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "strata-code.new.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "strata-code.new.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "strata-code.new.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "strata-code.new.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "strata-code.new.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection && stratacode.codeActions.enabled"
      },
      {
        "command": "strata-code.new.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "strata-code.new.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.newTerminal",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.advancedWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'strata-code.new.AgentManagerPanel'"
      },
      {
        "command": "strata-code.new.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "sideBarFocus && strata-code.new.sidebarVisible || activeWebviewPanelId == 'strata-code.new.AgentManagerPanel' || activeWebviewPanelId == 'strata-code.new.TabPanel'"
      },
      {
        "command": "strata-code.new.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "sideBarFocus && strata-code.new.sidebarVisible || activeWebviewPanelId == 'strata-code.new.AgentManagerPanel' || activeWebviewPanelId == 'strata-code.new.TabPanel'"
      },
      {
        "command": "strata-code.new.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && strata-code.new.autocomplete.hasSuggestions"
      },
      {
        "command": "strata-code.new.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && stratacode.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "strata-code.new.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && stratacode.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "strata-code.new.addToContext",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection && stratacode.codeActions.enabled"
      }
    ],
    "configuration": [
