        "category": "Strata Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strata-code.new.openMigrationWizard",
        "title": "Migrate Settings from Legacy Version",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "Strata Code",
        "icon": {
          "light": "assets/icons/strata-light.svg",
          "dark": "assets/icons/strata-dark.svg"
