        "category": "Strata Code API"
      },
      {
        "command": "strata-code.new.api.getActiveSession",
        "title": "Get Active Session",
        "category": "Strata Code API"
      },
      {
        "command": "strata-code.new.api.focus",
        "title": "Focus Strata Code",
        "category": "Strata Code API"
      },
      {
        "command": "strata-code.new.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Strata Code",
        "icon": "$(terminal)"
      },
      {
        "command": "strata-code.new.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "Strata Code",
        "icon": "$(play)"
      },
      {
        "command": "strata-code.new.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "Strata Code",
        "icon": "$(diff)"
      },
      {
        "command": "strata-code.new.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "Strata Code",
        "icon": "$(keyboard)"
      },
      {
        "command": "strata-code.new.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.newTerminal",
        "title": "Agent Manager: New Terminal Tab (Experimental)",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.newWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.advancedWorktree",
        "title": "Agent Manager: Advanced New Worktree",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "Strata Code"
      },
      {
        "command": "strata-code.new.agentManager.jumpTo7",
