name: strata

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  strata:
    if: |
      (github.event.comment.author_association == 'MEMBER' || github.event.comment.author_association == 'OWNER') &&
      (
        contains(github.event.comment.body, ' /kc') ||
        startsWith(github.event.comment.body, '/kc') ||
        contains(github.event.comment.body, ' /strata') ||
        startsWith(github.event.comment.body, '/strata')
      )
    runs-on: blacksmith-4vcpu-ubuntu-2404
    permissions:
      id-token: write
      contents: read
      pull-requests: read
      issues: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - uses: ./.github/actions/setup-bun

      - name: Run opencode
        uses: Strata-Org/stratacode/github@latest
        env:
          STRATA_API_KEY: ${{ secrets.STRATA_API_KEY }}
          STRATA_ORG_ID: ${{ secrets.STRATA_ORG_ID }}
          STRATA_PERMISSION: '{"bash": "deny"}'
        with:
          model: strata/strata-auto/frontier
